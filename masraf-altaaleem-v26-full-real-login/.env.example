NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=SERVER_ONLY_SECRET_KEY
OWNER_EMAIL=owner@example.com

# Messaging provider (server-only; never prefix these with NEXT_PUBLIC_)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
SUPABASE_SERVICE_ROLE_KEY=

# Student portal session signing secret (generate a random value of at least 32 chars)
STUDENT_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public production URL used for secure auth callbacks
NEXT_PUBLIC_APP_URL=https://your-domain.example
